# AgentTrace API/dashboard settings.
AGENTTRACE_AUTH_ENABLED=false
# AGENTTRACE_ADMIN_TOKEN=replace-with-a-long-random-secret
# AGENTTRACE_AUTH_COOKIE_NAME=agenttrace_session
